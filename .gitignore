# --- release hygiene (Task 23) ---
# agent/sandbox environment tooling (used on disk, never shipped)
/.agents/
/.codex/
skills-lock.json

# runtime process state (dev daemon pid)
*.pid

# sandbox user-upload mount (inputs land here; never commit)
/upload/

# e2e fixture regenerated by tests/browser/make-fixture.ts (volatile timestamps)
tests/browser/last-export.json

# oversized command output (auto-persisted by tooling; never commit)
tool-results/

# --- workspace environment overlays (present in this sandbox, not product files) ---
/examples/
/mini-services/
/download/

# --- v1 release hygiene (Task 29) ---
# sandbox dev-server supervisor (container boot tooling; lives on disk, never shipped)
/.zscripts/
# sandbox gateway reference copy (the live config is outside the repo)
/Caddyfile
# development-session process documents (worklogs, handoff and audit reports)
/worklog.md
/worklog-v1-history.md
/PASS_DOWN_REPORT.md
/AUDIT_REMEDIATION_REPORT.md
/PRODUCTION_CHECKLIST.md
