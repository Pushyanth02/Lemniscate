; EditorConfig — https://editorconfig.org
; One source of truth for whitespace across VS Code, Vim, JetBrains,
; and the GitHub web editor. (.vscode/settings.json points at this too.)

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
; trailing double-spaces are hard line breaks in Markdown
trim_trailing_whitespace = false
